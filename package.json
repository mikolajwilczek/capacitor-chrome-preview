{
  "name": "capacitor-chrome-preview",
  "version": "1.0.0",
  "type": "module",
  "description": "Chrome-based preview harness for Capacitor-style mobile app constraints.",
  "license": "MIT",
  "author": "Mikołaj Wilczek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikolajwilczek/capacitor-chrome-preview.git"
  },
  "homepage": "https://github.com/mikolajwilczek/capacitor-chrome-preview#readme",
  "bugs": {
    "url": "https://github.com/mikolajwilczek/capacitor-chrome-preview/issues"
  },
  "bin": {
    "capacitor-chrome-preview": "dist/preview.js"
  },
  "files": [
    "dist/",
    "docs/manual-safe-area-test.html"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "npm run test:build --silent && node --test .tmp/test-dist/tests/**/*.test.js",
    "check": "npm run typecheck --silent && npm run build --silent && npm test --silent",
    "prepack": "npm run check",
    "preview": "npm run build --silent && node dist/preview.js",
    "setup:hooks": "node scripts/configure-git-hooks.mjs"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0",
    "ink": "^7.1.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.17",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2"
  }
}
